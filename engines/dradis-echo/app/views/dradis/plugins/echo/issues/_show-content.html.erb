<% if Dradis::Plugins::Echo::Agents::Roslin.enabled? %>
  <div data-controller="dradis--plugins--echo--grammar"
       data-dradis--plugins--echo--grammar-grammar-corrections-url-value="<%= echo.project_grammar_corrections_path(current_project) %>"
       data-dradis--plugins--echo--grammar-grammar-suggestions-url-value="<%= echo.project_grammar_suggestions_path(current_project) %>"
       data-dradis--plugins--echo--grammar-commentable-type-value="<%= @issue.class %>"
       data-dradis--plugins--echo--grammar-commentable-id-value="<%= @issue.id %>">
  </div>
<% end %>

<div class="tab-pane" id="echo-tab">
  <div class="inner">
    <h4 class="header-underline mb-3">Dradis Echo</h4>

    <%# Native lazy frame: loads interactions#index when the Echo tab becomes %>
    <%# visible. index.html.erb answers with a matching <turbo-frame>, so initial %>
    <%# load, prompt->show and back->index all Turbo-frame-match the same id. %>
    <turbo-frame id="<%= dom_id(@issue, :echo) %>"
                 src="<%= echo.project_interactions_path(current_project, type: :issue, record: @issue.id) %>"
                 loading="lazy">
    </turbo-frame>
  </div>
</div>
