<%# locals: (session:) -%>
<%# Broadcast on every idle<->generating transition (Session#broadcast_composer_state). %>
<%# Route-free and locals-only so it renders from ReplyJob. %>
<div id="<%= dom_id(session, :composer_state) %>" data-behavior="echo-composer-state" data-generating="<%= session.generating? %>">
  <% if session.generating? %>
    <span class="echo-composer-status" data-behavior="echo-composer-generating">Generating…</span>
  <% else %>
    <span class="echo-composer-status" data-behavior="echo-composer-idle">Ready</span>
  <% end %>
</div>
