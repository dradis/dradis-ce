<turbo-frame id="<%= dom_id(@record, :echo) %>">
  <% unless @turbo_status %>
    <div class="alert alert-danger">
      There was an error contacting Redis: please make sure the Redis server is running.
    </div>
  <% end %>

  <%# Live transcript + composer state, both over the re-authorizing SessionsChannel %>
  <%# (Slice 4): the socket re-checks project access on every subscribe. %>
  <%= turbo_stream_from [@session, :messages], channel: Dradis::Plugins::Echo::SessionsChannel %>
  <%= turbo_stream_from [@session, :composer_state], channel: Dradis::Plugins::Echo::SessionsChannel %>

  <%# reply-pending / reply-url drive the client-side generation trigger: on a %>
  <%# freshly-created session (reply_pending?), the session controller POSTs to %>
  <%# this reply URL from `connect`, i.e. after the SessionsChannel subscription %>
  <%# is established, so ReplyJob's streaming container isn't broadcast before the %>
  <%# socket is listening (SEC-506 Bug 4). Revisiting an answered session renders %>
  <%# reply-pending=false, so no spurious generation is triggered. %>
  <div class="echo-conversation" data-controller="dradis--plugins--echo--session"
       data-dradis--plugins--echo--session-reply-url-value="<%= echo.project_session_reply_path(current_project, @session) %>"
       data-dradis--plugins--echo--session-reply-pending-value="<%= @session.reply_pending? %>">
    <div class="echo-conversation-header">
      <%= link_to echo.project_interactions_path(current_project, type: @type, record: @record.id),
            class: 'echo-back-link' do %>
        <i class="fa-solid fa-arrow-left"></i> Conversations
      <% end %>
      <h5 class="echo-conversation-title">
        <%= @session.title.presence || "Session ##{@session.id}" %>
        <span class="echo-conversation-agent">· with <%= @session.agent.name %></span>
      </h5>
    </div>

    <%# Broadcasts append to the literal `echo-messages` target (Message#broadcast_created), %>
    <%# so this id must stay verbatim; only one session view is mounted per Echo frame. %>
    <div id="echo-messages" class="echo-messages"
         data-dradis--plugins--echo--session-target="messages">
      <%= render partial: 'dradis/plugins/echo/projects/sessions/messages/message',
                 collection: @session.messages.order(:created_at, :id), as: :message %>

      <%# First-paint "thinking" bubble: a reply is owed but ReplyJob hasn't
          broadcast its streaming container yet (reply_pending?). Server-rendered
          here so it shows before any socket round-trip (Doherty), reusing the
          assistant/streaming classes verbatim so the real bubble swaps in with no
          layout jump. The id is a session-scoped sentinel — NOT dom_id(message) —
          so it can't collide with the #message_<id> container ReplyJob appends;
          Message#broadcast_created removes it when the real reply lands. %>
      <% if @session.reply_pending? %>
        <div id="<%= dom_id(@session, :pending_reply) %>" data-echo-pending-reply
             class="echo-message echo-message-assistant echo-message-streaming">
          <span class="echo-avatar-agent"><i class="fa-solid fa-robot"></i></span>
          <div class="echo-message-body">
            <div><span class="user"><%= @session.agent.name %></span></div>
            <div class="echo-streaming-caption" role="status">
              <span class="spinner-border spinner-border-xs" aria-hidden="true"></span>
              <span>Roslin is responding&hellip;</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%= form_with url: echo.project_session_messages_path(current_project, @session), method: :post,
          class: 'echo-composer',
          data: { action: 'submit->dradis--plugins--echo--session#send' } do |f| %>
      <%=
        f.text_area :content,
          class: 'form-control field-sizing-content',
          placeholder: 'Message Roslin…',
          rows: 2,
          data: { 'dradis--plugins--echo--session-target': 'input' }
      %>
      <%= render 'dradis/plugins/echo/projects/sessions/composer_state', session: @session %>

      <%# Hidden until the first-paint trigger POST fails (session_controller
          #unlockAfterFailedTrigger). role="status" so it's announced when it
          appears; sits outside the broadcast-replaced composer_state so a later
          broadcast can't wipe it (there is none in the failure branch anyway). %>
      <span class="echo-composer-hint echo-composer-retry" role="status" hidden
            data-dradis--plugins--echo--session-target="retryHint">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        Couldn&rsquo;t start Roslin — send your message to retry.
      </span>
    <% end %>
  </div>
</turbo-frame>
