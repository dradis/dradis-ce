<%= simple_form_for @prompt do |f| %>
  <%= f.error_notification %>

  <%= f.input :title %>

  <%= f.input :icon do %>
    <%=
      f.select :icon,
        options_for_select(prompt_icons_collection, @prompt.icon),
        {},
        class: 'form-select'
    %>
  <% end %>

  <%=
    f.input :scope,
      collection: Dradis::Plugins::Echo::Prompt::SCOPES.map { |scope| [scope.to_s.titleize, scope] },
      include_blank: false,
      label: 'Prompt Scope'
  %>

  <%= f.input :prompt, input_html: { rows: 10 } %>

  <div>
    <%= f.button :submit, class: 'btn btn-primary' %> or <%= link_to 'Cancel', prompts_path %>
  </div>
<% end %>
