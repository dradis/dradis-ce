<%= simple_form_for @prompt do |f| %>
  <%= f.error_notification %>

  <%= f.input :title %>

  <div class="mb-3">
    <%= f.label :icon, 'Icon', class: 'form-label' %>
    <%=
      f.select :icon,
        options_for_select(prompt_icons_collection, @prompt.icon),
        {},
        class: 'form-select'
    %>
  </div>

  <div class="mb-3">
    <%= f.label :scope, 'Prompt Scope', class: 'form-label' %>
    <%=
      f.select :scope,
        options_for_select(Dradis::Plugins::Echo::Prompt::SCOPES.map { |scope| [scope.to_s.titleize, scope] }, @prompt.scope),
        {},
        class: 'form-select'
    %>
  </div>

  <%= f.input :prompt, input_html: { rows: 10 } %>

  <div>
    <%= f.submit class: 'btn btn-primary' %> or <%= link_to 'Cancel', prompts_path %>
  </div>
<% end %>
