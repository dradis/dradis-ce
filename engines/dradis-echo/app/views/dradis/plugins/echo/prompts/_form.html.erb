<%= simple_form_for @prompt do |f| %>
  <%= f.error_notification %>

  <%= f.input :title %>

  <%=
    f.input :icon,
      collection: prompt_icons_collection,
      include_blank: false
  %>

  <%=
    f.input :scope,
      collection: Dradis::Plugins::Echo::Prompt::SCOPES.map { |scope| [scope.to_s.titleize, scope] },
      include_blank: false,
      label: 'Prompt Scope'
  %>

  <%= f.input :prompt, input_html: { rows: 10 } %>

  <div>
    <%= f.submit class: 'btn btn-primary' %> or <%= link_to 'Cancel', prompts_path %>
  </div>
<% end %>
