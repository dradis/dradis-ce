<section class="summary-panel">
  <h4 class="header-underline">Issues so far
    <% if defined?(Dradis::Pro) %>
    <span class="actions pt-1">
      <div class="action">
        <select class="form-select form-select-sm issues-grouping-select"
                data-controller="issues-grouping"
                data-issues-grouping-project-id-value="<%= current_project.id %>"
                data-issues-grouping-target="select">
          <option value="tags" <%= 'selected' if @grouping == 'tags' %>>Tags</option>
          <optgroup label="Lists">
            <% if @list_fields.any? %>
              <% @list_fields.each do |field| %>
                <option value="list:<%= field.name %>" <%= 'selected' if @grouping == "list:#{field.name}" %>><%= field.name %></option>
              <% end %>
            <% else %>
              <option disabled>No lists defined in report template.</option>
            <% end %>
          </optgroup>
        </select>
      </div>
    </span>
    <% end %>
  </h4>

  <%= turbo_frame_tag 'issues-summary', src: project_dashboard_issues_path(current_project) %>
</section>
