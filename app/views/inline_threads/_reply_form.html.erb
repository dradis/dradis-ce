<div id="thread_<%= inline_thread.id %>_reply_form">
  <%= form_with url: inline_thread_comments_path(inline_thread) do |f| %>
    <%= f.text_area :content,
          name: 'comment[content]',
          data: {
            controller: 'mentions',
            mentions_users_value: tribute_hash(comment_mentionable_users(inline_thread.commentable)),
            mentions_fallback_image_value: image_path(AvatarHelper::DEFAULT_PROFILE_IMAGE),
            behavior: 'inline-thread-input'
          },
          class: 'form-control form-control-sm mb-2',
          placeholder: 'Reply...',
          rows: 2 %>
    <%= f.submit 'Reply', class: 'btn btn-sm btn-primary' %>
  <% end %>
</div>
