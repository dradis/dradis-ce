<div class="comment-feed" data-behavior="comment-feed">
  <% cache ['comment-feed', @commentable, @comments] do %>
    <div id="<%= dom_id(@commentable, :comments) %>" data-behavior="comment-list">
      <%= render(partial: 'comments/comment', collection: @comments, cached: true) if @comments.any? %>
      <div data-notice="no-comments" class="comment <%= 'd-none' if @comments.any? %>" data-comment-feed-target="empty">
        There have been no comments yet.
      </div>
    </div>
  <% end %>
  <%= render 'comments/new', comment: Comment.new(commentable: @commentable) %>
</div>
