<% field_row = render partial: 'field', locals: { index: @index } %>
var fieldGroup = $('<%= escape_javascript(field_row) %>');

// Add the field to the editor whose Add field link was clicked, as a page can
// have several. Without an editor id, use the first editor on the page.
var $editor = $('[data-textile-editor-id="<%= escape_javascript(@editor_id.to_s) %>"]');
if (!$editor.length) { $editor = $('.textile').first(); }
var textile = $editor.data('plugin_textile');

$('[data-behavior~=textile-form-body]', textile.options.$fields).append(fieldGroup);
textile.bindFieldGroup(fieldGroup);

$('[data-behavior~=rich-toolbar]', fieldGroup).each(function() {
  new EditorToolbar($(this));
});
