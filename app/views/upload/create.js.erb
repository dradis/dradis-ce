(() => {
  $('[data-behavior~=item-id]').val('<%= @item_id %>');
  $('[data-behavior~=attachment]').val('<%= j @attachment.filename %>');
  $('[data-behavior~=filesize]').text('(<%=j number_to_human_size(File.size(@attachment.fullpath)) %>)');
  $('[data-behavior~=spinner]').addClass('d-none');

  const $console = $('[data-behavior~=upload-console]');
  $console.html('<%= j render('consoles/console', state: :running, uid: @item_id) %>');
  // Listen on this upload's console, not the wrapper, so the listeners go
  // away when the next upload replaces it
  const consoleElement = $console[0].querySelector('[data-controller~=console]');
  // Inserted after page load, so its behaviors (e.g. Copy log) need setting up
  window.initBehaviors(consoleElement);

  const data = {
    file: '<%= j @attachment.filename %>',
    item_id: '<%= @item_id %>',
    uploader: '<%= j params[:uploader] %>'
  };
  <% if @state %>
    data.state = '<%= j @state %>';
  <% end %>

  // If the request to start the import fails, no final status will be
  // broadcast, so show the failure here
  const showFailed = () => {
    const $status = $(consoleElement).find('[data-console-target~=status]');
    if ($status.data('state') !== 'running') return;

    $(consoleElement).find('[data-console-target~=lines]').append('<%= j render('consoles/line', text: 'The import could not be started. Please try again, or check the server logs.') %>');
    const $failedStatus = $('<%= j render('consoles/status', state: :failed, uid: @item_id) %>');
    $status.replaceWith($failedStatus);
    window.initBehaviors($failedStatus[0]);
  };

  // Start the import once the console is listening, so it doesn't miss
  // any line. Start anyway after a few seconds if it can't connect.
  let started = false;
  const startImport = () => {
    if (started) return;
    started = true;
    $.post($('[data-behavior~=new-upload]').data('parse-url'), data, null, 'script')
      .fail(showFailed);
  };
  consoleElement.addEventListener('console:connected', startImport, { once: true });
  setTimeout(startImport, 5000);

  // Plugins (e.g. CSV, to open its column mapper) listen for job-done,
  // which the polling console used to fire. Not on failure, so the
  // failed status stays on screen.
  consoleElement.addEventListener('console:finished', (event) => {
    if (event.detail.state !== 'completed') return;

    window.dispatchEvent(new CustomEvent('job-done', { detail: { state: 'end' } }));
  }, { once: true });
})();
