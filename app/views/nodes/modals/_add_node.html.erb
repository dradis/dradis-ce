<div
  id="modal_add_<%= type %>_node"
  class="modal fade"
  tabindex="-1"
  role="dialog"
  aria-hidden="true"
  data-behavior="add-node"
  aria-labelledby="modal-title"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <%= render 'nodes/modals/add_node_content', type: type, parent: @node %>
    </div>
  </div>
</div>
