<div
  id="modal_add_<%= type %>_node"
  class="modal fade"
  tabindex="-1"
  role="dialog"
  aria-hidden="true"
  data-behavior="add-node"
  aria-labelledby="modal-title"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <% if type == :branch %>
        <%= render 'nodes/modals/add_node_content', type: :branch %>
      <% else %>
        <%# Nodes::SubnodesController#new loads the form for the node whose
          # 'Add subnode' link opened this modal %>
        <%= turbo_frame_tag 'add_subnode_form' do %>
          <div class="modal-body"><%= spinner_tag %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
