<%= simple_form_for [current_project, @node, @evidence],
  html: {
    data: {
      behavior: 'local-auto-save',
      auto_save_key: @auto_save_key
    }
  } do |f| %>

  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :issue, collection: current_project.issues.sort, label_method: :title, include_blank: 'Auto-generate a new issue' %>

    <%= label_tag :evidence_content, 'Evidence content', class: 'visually-hidden' %>
    <%=
      f.input :content,
      label: false,
      input_html: {
        class: 'textile',
        data: {
          behavior: 'auto-save rich-toolbar drop-zone',
          paths: editor_paths,
          'rich-toolbar': 'defaults field image',
          'rich-toolbar-uploader': '[data-behavior~=jquery-upload]',
        },
        rows: 20
      }
    %>
  </div>

  <% if @evidence.persisted? %>
    <%= hidden_field :evidence, :original_updated_at, value: @evidence.updated_at.to_i %>
  <% end %>

  <div class="form-actions sticky">
    <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
    <%= render partial: 'qa/state_button', locals: { f: f, record: @evidence } %> or
    <%=
      link_to 'Cancel',
      @form_cancel_path,
      data: {
        action: ('record-locking#release' if @evidence.persisted?),
        behavior: 'clear-local-auto-save',
        controller: ('record-locking' if @evidence.persisted?),
        record_locking_path_value: (project_node_evidence_editing_session_path(current_project, @node, @evidence) if @evidence.persisted?)
      }
    %>
  </div>
<% end %>
