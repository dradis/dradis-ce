<%# locals: (issue:) %>
<%#
  # The default row actions on Issues#import. An addon's own row actions keep
  # the markup importer.js reads: an Add Issue link with
  # data-behavior="add-issue", data-entry-id, data-text and data-state.
%>
<%# Display the Add Issue link for plugins that don't provide a state %>
<%# For plugins that do provide a state show only for published %>
<% if issue.state.nil? || issue.published? %>
  <% default_state = issue.state ? 'published' : 'draft' %>
  <div class="btn-group btn-states" data-behavior="btn-states">
    <%= link_to main_app.project_issues_path(current_project, format: :js), class: 'btn btn-primary', data: { entry_id: issue.id, text: issue.text, state: default_state, behavior: 'add-issue' } do %>
      <i class="fa-solid fa-plus"></i> Add issue (<span data-behavior="state-button"><%= default_state.humanize %></span>)
    <% end %>
    <a href="#" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
      <span class="visually-hidden">Toggle Dropdown</span>
    </a>
    <div class="dropdown-menu">
      <%= collection_radio_buttons(issue, :state, Issue.states, :first, :first) do |b| %>
        <span>
          <%= b.label class: 'state' do %>
            <%= b.radio_button(class: 'd-none', data: { behavior: 'state-radio' }, checked: b.value == default_state) %>
            <i class="fa-solid fa-check fa-fw"></i>
            <div class="state-label">
              <p data-behavior="state-label"><%= b.text.humanize %></p>
              <% case b.value %>
              <% when 'draft' %>
                <span>Still not ready for review or the report.</span>
              <% when 'ready_for_review' %>
                <span>All done on this one, ready for QA.</span>
              <% when 'published' %>
                <span>Content is final, ready for the report.</span>
              <% end %>
            </div>
          <% end %>
        </span>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="btn-group" title="This result is still in a <%= issue.state.humanize.titleize %> state. Publish it in the library before importing to the project." data-bs-toggle="tooltip">
    <a href="javascript:void(0)" class="btn btn-primary disabled" disabled="disabled">
      <i class="fa-solid fa-plus"></i> Add Issue (Published)
    </a>
    <a
      href="javascript:void(0)"
      class="btn btn-primary dropdown-toggle dropdown-toggle-split disabled"
      disabled="disabled"
      role="presentation"
    ></a>
  </div>
<% end %>
