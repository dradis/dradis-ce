<table class="table table-striped mb-0"
  data-behavior="dradis-datatable"
  data-can-publish="<%= can?(:publish, current_project) %>"
  data-default-columns="<%= @default_columns.to_json %>"
  data-item-name=<%= "issue_#{@issue.id}_evidence" %>
  data-local-storage-key="project.ce.<%= dom_id(current_project) %>.<%= "issue_#{@issue.id}_evidence_datatable" %>"
  data-state-icons="<%= state_icons.to_json %>"
  >
  <thead>
    <tr>
      <th class="no-sort" data-column-visible="false"><span class="visually-hidden">Select</span></th>
      <% @all_columns.each do |column| %>
        <th><%= column %></th>
      <% end %>
      <th class="no-sort" data-column-visible="false"><span class="visually-hidden">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <% @affected_nodes.each do |node| %>
      <% @node_evidence[node].each do |evidence| %>
        <tr id="evidence-<%= evidence.id %>">
          <td class="select-checkbox" data-behavior="select-checkbox"></td>
          <% @all_columns.each do |column| %>
            <%
              sort, display =
              case column
              when 'Label'
                label_path = [current_project, node, evidence]
                qa_label_path = project_qa_issue_evidence_path(current_project, @issue, evidence)
                [evidence.node.label,
                 (link_to(evidence.node.label, label_path, data: { qa_visible: false }) +
                  link_to(evidence.node.label, qa_label_path, class: 'd-none', data: { qa_visible: true }))]
              when 'State'
                [evidence.state_before_type_cast, evidence.state.humanize]
              when 'Created'
                [evidence.created_at.to_i, local_time_ago(evidence.created_at)]
              when 'Created by'
                [evidence.author, evidence.author]
              when 'Updated'
                [evidence.updated_at.to_i, local_time_ago(evidence.updated_at)]
              else
                [evidence.fields.fetch(column, ''), markup(evidence.fields.fetch(column, ''))]
              end
            %>
            <td data-sort="<%= sort %>"><%= display %></td>
          <% end  %>
          <td class="column-actions">
            <%= link_to edit_project_node_evidence_path(current_project, node, evidence, return_to: :issue), data: { qa_visible: false } do %>
              <i class="fa-solid fa-pencil"></i> Edit
            <% end %>
            <%= link_to edit_project_qa_issue_evidence_path(current_project, @issue, evidence, return_to: :qa), class: 'd-none', data: { qa_visible: true } do %>
              <i class="fa-solid fa-pencil"></i> Edit
            <% end %>
            <%= link_to [current_project, node, evidence],
                  class: 'text-error-hover',
                  data: { confirm: "Are you sure?\n\nProceeding will delete this evidence from the associated node.", qa_visible: false },
                  method: :delete do %>
              <i class="fa-solid fa-trash"></i> Delete
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
