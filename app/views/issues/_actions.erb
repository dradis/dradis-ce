<span class="actions">
  <span class="action">
    <%= link_to edit_project_issue_path(current_project, @issue), data: { turbo_frame: dom_id(@issue) } do %>
      <i class="fa-solid fa-pencil fa-fw"></i> Edit
    <% end %>
  </span>
  <div class="dropdown dots-dropdown">
    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-h fa-lg"></i><span class="visually-hidden">Toggle menu</span></a>
    <div class="dropdown-menu">
      <%= link_to [current_project, @issue],
        class: 'dropdown-item text-error-hover',
        data: { confirm: "Are you sure?\n\nProceeding will delete this issue and any associated evidence.", turbo_frame: '_top' },
        method: :delete do %>
        <i class="fa-solid fa-trash fa-fw"></i> Delete
      <% end %>
      <%= render partial: 'subscriptions/actions', locals: { subscribable: @issue, dots_menu: true } %>
      <%= link_to(project_issue_revisions_path(current_project, @issue), class: 'dropdown-item', data: { turbo_frame: '_top' }) do %>
        <i class="fa-solid fa-history fa-fw"></i> View History
      <% end %>
      <%= render partial: 'send_to_menu' %>
    </div>
  </div>
</span>
