<div class="header">
  <div class="header-inner">
    <h5 class="header-name">Import issues</h5>
    <div class="options">
      <%= link_to '#import-box', 
        class: 'import-toggle', 
        data: { bs_toggle: 'collapse', behavior: 'collapse-collection import-box-header' } do %>
        <i class="fa-solid fa-chevron-up" data-behavior="toggle-chevron"></i><span class="visually-hidden">Toggle import box</span>
      <% end %>
    </div>
  </div>
</div>

<%= content_tag :div, class: 'import-box collapse show', id: 'import-box', data: { behavior: 'import-box' } do %>
  <% if Dradis::Plugins::with_feature(:import).empty? %>
    <p>
      Connect Dradis to a library of issue descriptions so you don't have to
      copy & paste findings from an old report.
    </p>
    <p class="mb-2">Libraries:</p>
    <ul class="fa-ul">
      <li><i class="fa-solid fa-li fa-chevron-right"></i>
        <a href="https://dradis.com/integrations/mediawiki.html?utm_source=ce&utm_medium=app" target="_blank">
          MediaWiki
        </a>
      </li>
      <li><i class="fa-solid fa-li fa-chevron-right"></i>
        <%= link_to main_app.static_issuelib_path do %>
          <i class="fa-solid fa-book"></i> Built-in Issue Library
        <% end %>
      </li>
    </ul>
    <form action="<%=  main_app.static_issuelib_import_path %>" class="form-inline mb-4" method="get">
      <div class="inset-button-wrapper">
        <input type="text" class="form-control search-query" placeholder="Search Issue Library" />
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>
  <% else %>
    <%# Each import addon ships its own search UI as issues/_import_box under
        its engine's view path, the way export addons ship their tab and form.
        An addon that only registers Import::Filters can render
        issues/import_box/filters for the default search form. %>
    <%= render_view_hooks 'issues/import_box', feature: :import %>
  <% end %>
<% end %>
