<%= flash_messages %>

<%= render partial: 'setup/progress' %>

<%= simple_form_for @password_form, url: setup_password_path do |f| %>
  <%= f.error_notification class: 'mt-5' %>

  <h1>Let's start with setting your shared password</h1>
  <p class="small">This shared password will be used by every user accessing this Dradis server.</p>

  <%= f.input :password, autofocus: true, input_html: { autocomplete: 'off' } %>
  <%= f.input :password_confirmation, input_html: { autocomplete: 'off' } %>

  <%= button_tag :submit, class: 'btn btn-primary' do %>
    Next <i class="fa-solid fa-long-arrow-right"></i>
  <% end %>
<% end %>
