<% avatar_limit = 4 %>

<%= turbo_frame_tag dom_id(@subscribable, :subscriptions) do %>
  <% if @subscribers.any? %>
    <% hidden_count = @subscribers.size - avatar_limit %>

    <div class="action subscribers" data-behavior="subscribers">
      <% @subscribers.first(avatar_limit).each do |subscriber| %>
        <span class="subscriber" tabindex="0" data-bs-toggle="tooltip" data-bs-title="<%= subscriber.name %>">
          <%= avatar_image(subscriber, size: 28, title: nil) %>
        </span>
      <% end %>
      <% if hidden_count > 0 %>
        <span class="subscribers-overflow"
              tabindex="0"
              data-behavior="subscribers-overflow"
              data-bs-toggle="tooltip"
              data-bs-title="<%= @subscribers.drop(avatar_limit).map(&:name).join(', ') %>">
          +<%= hidden_count %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="action">
    <% if @subscription %>
      <%= link_to main_app.subscription_path(@subscribable, subscription: subscription_params_for(@subscribable)), data: { turbo_method: :delete } do %>
        <i class="fa-solid fa-bell-slash fa-fw"></i> Unsubscribe
      <% end %>
    <% else %>
      <%= link_to main_app.subscriptions_path(subscription: subscription_params_for(@subscribable)), data: { turbo_method: :post } do %>
        <i class="fa-solid fa-bell fa-fw"></i> Subscribe
      <% end %>
    <% end %>
  </div>
<% end %>
