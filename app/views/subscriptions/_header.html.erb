<% max_avatars = 4 %>
<% subscribers = subscriptions.filter_map(&:user) %>
<% subscription_params = {
     subscription: {
       subscribable_type: subscribable.class.to_s,
       subscribable_id: subscribable.id
     }
   } %>

<%= turbo_frame_tag dom_id(subscribable, :subscriptions),
      class: 'actions d-flex align-items-center ms-auto pt-1',
      data: { behavior: 'subscriptions-header' } do %>
  <% if subscribers.any? %>
    <% hidden_count = subscribers.size - max_avatars %>

    <div class="action dropdown subscribers" data-behavior="subscribers">
      <button class="subscribers-toggle"
              type="button"
              aria-expanded="false"
              aria-label="Show all <%= pluralize(subscribers.size, 'subscriber') %>"
              data-behavior="subscribers-toggle"
              data-bs-toggle="dropdown">
        <span class="subscribers-stack">
          <% subscribers.first(max_avatars).each do |subscriber| %>
            <%= avatar_image(subscriber, size: 28, title: nil) %>
          <% end %>
          <% if hidden_count > 0 %>
            <span class="subscribers-overflow" data-behavior="subscribers-overflow">
              +<%= hidden_count %>
            </span>
          <% end %>
        </span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><span class="dropdown-header"><%= pluralize(subscribers.size, 'subscriber') %></span></li>
        <% subscribers.each do |subscriber| %>
          <li>
            <span class="dropdown-item-text">
              <%= avatar_image(subscriber, size: 24, include_name: true, alt: '', title: nil) %>
              <% if subscriber == current_user %>
                <span class="text-muted">(you)</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="action">
    <% if subscription %>
      <%= link_to main_app.subscription_path(subscribable, subscription_params), data: { turbo_method: :delete } do %>
        <i class="fa-solid fa-bell-slash fa-fw"></i> Unsubscribe
      <% end %>
    <% else %>
      <%= link_to main_app.subscriptions_path(subscription_params), data: { turbo_method: :post } do %>
        <i class="fa-solid fa-bell fa-fw"></i> Subscribe
      <% end %>
    <% end %>
  </div>
<% end %>
