<div id="modal-console" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modal-title" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-title">Output console</h5>
      </div>
      <div class="modal-body">
        <%= render 'logs/status', log: nil %>
        <%= content_tag :div,
                        id: 'result',
                        style: 'display:none',
                        data: {
                          url: main_app.status_console_index_path
                        }  do %>
          <div data-behavior="console-mount"></div>
          <div id="console" class="console mx-0 mb-0" data-behavior="console" data-controller="console-scroll"></div>
        <% end %>
      </div>
      <div class="modal-footer d-none">
        <button class="btn btn-primary" type="button" data-bs-dismiss="modal" aria-hidden="true">Done!</button>
      </div>
    </div>
  </div>
</div>
