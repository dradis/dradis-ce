<%= content_tag :div, id: "#{dom_id(record)}_link", class: class_names('list-item', active: params[:id].to_i == record.id) do %>
  <%= link_to project_qa_issue_evidence_path(current_project, @issue, record) do %>
    <%= colored_icon_for_model(record, 'fa-laptop', 'list-item-icon') %>
    <%= record.node.label %>
  <% end %>

  <div class="list-item-actions">
    <%= link_to evidence_edit_path(record, qa: true), class: 'list-item-action-edit' do %>
      <i class="fa-solid fa-pencil fa-fw"></i><span class="visually-hidden">Edit</span>
    <% end %>
  </div>
<% end %>
